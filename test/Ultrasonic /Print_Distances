#include <Arduino.h>
#include <TFT_eSPI.h>

#define US_TRIG 16
#define US_ECHO 21

TFT_eSPI tft = TFT_eSPI();

const unsigned long TIMEOUT_US = 30000;  // ~5 m max timeout

float readDistanceCM() {
  // Ensure clean LOW pulse first
  digitalWrite(US_TRIG, LOW);
  delayMicroseconds(2);

  // Trigger 10 us pulse
  digitalWrite(US_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(US_TRIG, LOW);

  // Read echo pulse length
  unsigned long duration = pulseIn(US_ECHO, HIGH, TIMEOUT_US);

  // If no echo received, return -1
  if (duration == 0) {
    return -1.0;
  }

  // Distance in cm
  // speed of sound ≈ 0.0343 cm/us
  // divide by 2 because pulse goes out and back
  float distance = (duration * 0.0343) / 2.0;
  return distance;
}

void setup() {
  pinMode(15, OUTPUT);   // TTGO backlight pin from your earlier setup
  digitalWrite(15, HIGH);

  pinMode(US_TRIG, OUTPUT);
  pinMode(US_ECHO, INPUT);

  digitalWrite(US_TRIG, LOW);

  tft.init();
  tft.setRotation(1);   // change to 3 if screen is upside down
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setTextSize(2);

  tft.setCursor(20, 20);
  tft.println("Ultrasonic");

  tft.setCursor(20, 50);
  tft.println("Distance:");
}

void loop() {
  float distanceCM = readDistanceCM();

  // Clear just the value area
  tft.fillRect(20, 90, 220, 40, TFT_BLACK);
  tft.setCursor(20, 90);

  if (distanceCM < 0) {
    tft.println("No echo");
  } else {
    tft.print(distanceCM, 1);
    tft.println(" cm");
  }

  delay(200);
}