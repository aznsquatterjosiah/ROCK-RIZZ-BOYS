#include <Arduino.h>
#include <ESP32Servo.h>

Servo wallLeftServo;
Servo wallRightServo; // FROM THE REAR

static const int WALL_LEFT_PIN  = 10; //yellow
static const int WALL_RIGHT_PIN = 11; //green

void setup() {

  pinMode(15, OUTPUT);
  digitalWrite(15, HIGH);
  
  Serial.begin(115200); 

  wallLeftServo.setPeriodHertz(50);
  wallRightServo.setPeriodHertz(50);

  wallLeftServo.attach(WALL_LEFT_PIN, 500, 2400);
  wallRightServo.attach(WALL_RIGHT_PIN, 500, 2400);
}

void loop() {
  wallLeftServo.write(180);      // facing down, starting state
  wallRightServo.write(0);
  delay(2000);

  wallLeftServo.write(80); // scoop facing forward
  wallRightServo.write(100);
  delay(2000);

  wallLeftServo.write(40); // scoop facing forward
  wallRightServo.write(140);
  delay(2000);



}