#include <Arduino.h>
#include <ESP32Servo.h>

// SERVO OBJECTS 

Servo wallServo360;   // green thick 360 continuous servo
Servo flapServo;      // normal flap servo

//  L298N ACTUATOR PINS

const int ENA = 1;
const int IN1 = 2;
const int IN2 = 3;

// EXTENDER MOTOR PINS

const int EXT_EN  = 4;
const int EXT_IN1 = 43;
const int EXT_IN2 = 44;

// PWM SETTINGS 

const int PWM_CH   = 0;
const int PWM_FREQ = 20000;
const int PWM_RES  = 8;

// Servo Pins

static const int WALL_SERVO_PIN = 11; // green 360 servo
static const int FLAP_SERVO_PIN = 12; // flap servo

const int POWER_PIN = 15;

// Speed

const int EXT_SPEED = 150;

// 360 Servo Functions 

static const int SERVO_STOP = 1500;
static const int SERVO_CW   = 1000;
static const int SERVO_CCW  = 2000;

// Tune these times if needed

static const int WALL_FACE_FORWARD_TIME = 500;
static const int WALL_ANGLE_UP_TIME     = 200;
static const int TIME_UP_TO_DROP      = 300;
static const int WALL_BACK_DOWN_TIME    = 560;

// Flap Angles 

const int FLAP_DOWN = 10;
const int FLAP_UP   = 70;

int currentFlap = FLAP_DOWN;

// Motor_Actuator Functions

void stopExtender() {
  digitalWrite(EXT_IN1, LOW);
  digitalWrite(EXT_IN2, LOW);
  ledcWrite(PWM_CH, 0);
  Serial.println("Extender stopped");
}

void extenderForward(int speedVal) {
  digitalWrite(EXT_IN1, HIGH);
  digitalWrite(EXT_IN2, LOW);
  ledcWrite(PWM_CH, speedVal);
  Serial.println("Extender forward");
}

void extenderBackward(int speedVal) {
  digitalWrite(EXT_IN1, LOW);
  digitalWrite(EXT_IN2, HIGH);
  ledcWrite(PWM_CH, speedVal);
  Serial.println("Extender backward");
}

void stopActuator() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  Serial.println("Actuator stopped");
}

void extendActuator() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  Serial.println("Actuator extending");
}

void retractActuator() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  Serial.println("Actuator retracting");
}

// 360 Servo Functions 

void stopWallServo() {
  wallServo360.writeMicroseconds(SERVO_STOP);
}

void rotateWallServo(int pulse, int timeMs) {
  wallServo360.writeMicroseconds(pulse);
  delay(timeMs);
  stopWallServo();
  delay(300);
}

void wallFaceForward() {
  Serial.println("Wall: FACE FORWARD");
  rotateWallServo(SERVO_CW, WALL_FACE_FORWARD_TIME);
}

void wallAngleUp() {
  Serial.println("Wall: ANGLE UP");
  rotateWallServo(SERVO_CW, WALL_ANGLE_UP_TIME);
}

void drop_rocks() {
  Serial.println("STATE: DROP_ROCKS");
  // From ANGLE_UP, go back through facing forward, then 45 degrees downward
  rotateServo(SERVO_CCW, TIME_UP_TO_DROP);
}

void wallBackDown() {
  Serial.println("Wall: BACK DOWN TO ORIGINAL POSITION");
  rotateWallServo(SERVO_CCW, WALL_BACK_DOWN_TIME);
}

// Flap Servo Functions

void attachFlap() {
  if (!flapServo.attached()) {
    flapServo.attach(FLAP_SERVO_PIN, 500, 2400);
    delay(50);
  }
}

void detachFlap() {
  if (flapServo.attached()) {
    flapServo.detach();
    delay(20);
  }
}

void moveFlapSlow(int targetFlap, int stepDelay = 35) {
  attachFlap();

  int startFlap = currentFlap;
  int steps = abs(targetFlap - startFlap);

  if (steps == 0) {
    return;
  }

  for (int i = 1; i <= steps; i++) {
    int newFlap = startFlap + (targetFlap - startFlap) * i / steps;
    flapServo.write(newFlap);
    delay(stepDelay);
  }

  currentFlap = targetFlap;

  Serial.print("Flap at ");
  Serial.println(currentFlap);
}

void flapDown() {
  Serial.println("Flap: DOWN");
  moveFlapSlow(FLAP_DOWN, 35);
}

void flapOpen() {
  Serial.println("Flap: OPEN");
  moveFlapSlow(FLAP_UP, 45);
}

// Setup

void setup() {
  pinMode(POWER_PIN, OUTPUT);
  digitalWrite(POWER_PIN, HIGH);

  Serial.begin(115200);

  // 360 wall servo setup

  wallServo360.setPeriodHertz(50);
  wallServo360.attach(WALL_SERVO_PIN, 800, 2200);
  stopWallServo();

  // Flap servo setup

  flapServo.setPeriodHertz(50);
  attachFlap();
  flapDown();

  // Linear actuator setup

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  digitalWrite(ENA, HIGH);

  // Extender setup
  pinMode(EXT_IN1, OUTPUT);
  pinMode(EXT_IN2, OUTPUT);

  ledcSetup(PWM_CH, PWM_FREQ, PWM_RES);
  ledcAttachPin(EXT_EN, PWM_CH);

  stopExtender();
  stopActuator();

  Serial.println("Combined actuator, extender, 360 wall servo, and flap code ready.");



  // Start Loop PICKUP

  // Initial Delay to allow button 

  delay(4000);

  // Step 1: Actuate Up

  extendActuator();
  delay(2000);

  stopActuator();
  delay(2000);
  
  // Step 2: delay for driving forward 

  delay(2000);

  // Step 3: Actuate Down

  retractActuator();   // retract down for wall to push
  delay(1200);

  stopActuator();
  delay(1000);

  // Step 4: Extend extender rack to push rocks

  extenderForward(EXT_SPEED);
  delay(1300);

  stopExtender();
  delay(1000);

  // Step 5: Retract extender rack to original position

  extenderBackward(EXT_SPEED);
  delay(1000);

  stopExtender();
  delay(2000);

  // Step 6: Actuate Up

  extendActuator();
  delay(2000);

  stopActuator();
  delay(2000);

  // Step 7: Servo Scoop facing 90 deg 

  wallFaceForward();
  delay(2000);


  // Step 8: Retract LA level with ground

  retractActuator();
  delay(4500);

  stopActuator();
  delay(2000);

  // Step 9: Extend forward max to push rocks 

  extenderForward(EXT_SPEED);
  delay(1300);

  stopExtender();
  delay(2000);

  // Step 10: Anlge 45 Deg

  wallAngleUp();
  delay(2000);

  delay(1000);


  // Step 11: Flap close 

  flapOpen();
  delay(400);


  // Step 12: Extend actuator

  extendActuator();
  delay(2000);

  stopActuator();
  delay(2000);
  
  // Step 13: Bring extender back

  extenderBackward(EXT_SPEED);
  delay(1400);

  stopExtender();
  delay(2000);






  // HOPPER STATES

  // Step 1 Actaute Up 
  extendActuator();
  delay(10000);

  stopActuator();
  delay(2000);


  // Step 2 Extend, extender_rack 

  extenderForward(EXT_SPEED);
  delay(1300);

  stopExtender();
  delay(2000);
    


  // Step 3  drop
  
  drop_rocks();
  delay(2000);

  // step 4 flap open 

  
  flapDown();
  delay(2000);


  // Step 5 Retract, extender_rack 

  extenderBackward(EXT_SPEED);
  delay(1400);

  stopExtender();
  delay(2000);

  // realisically rest of drive states now and finish


  // Calibration for start of next run:

//   //  Extend full way for cal   actuator already up in this case

//   extendActuator();
//   delay(10000);

//   stopActuator();
//   delay(2000);

  // Scoop Wall Down

  wallBackDown();
  delay(2000);



  // Flap to original position

  flapDown();
  delay(2000);



  // Retract to start state

  retractActuator();
  delay(9500);

  stopActuator();
  delay(2000);
 




  Serial.println("Sequence complete.");
}


void loop() {
 
}