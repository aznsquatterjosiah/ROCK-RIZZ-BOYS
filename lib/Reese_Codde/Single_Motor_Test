#include <Arduino.h>

const int ENA = 4;
const int IN1 = 5;
const int IN2 = 6;

const int PWM_CH = 0;
const int PWM_FREQ = 1000;
const int PWM_RES = 8; // 0-255

void setMotor(int pwm, bool forward) {
  if (forward) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
  } else {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
  }
  ledcWrite(PWM_CH, pwm);
}

void stopMotor() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  ledcWrite(PWM_CH, 0);
}

void setup() {
  Serial.begin(115200);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  ledcSetup(PWM_CH, PWM_FREQ, PWM_RES);
  ledcAttachPin(ENA, PWM_CH);

  stopMotor();
}

void loop() {
  Serial.println("Forward");
  setMotor(180, true);
  delay(2000);

  Serial.println("Stop");
  stopMotor();
  delay(1000);

  Serial.println("Reverse");
  setMotor(180, false);
  delay(2000);

  Serial.println("Stop");
  stopMotor();
  delay(1000);
}