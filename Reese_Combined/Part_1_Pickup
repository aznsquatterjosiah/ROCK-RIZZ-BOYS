#include <Arduino.h>
#include <ESP32Servo.h>

Servo wallLeftServo;
Servo wallRightServo; // FROM THE REAR
Servo FlapServo;

// L298N pins
const int ENA = 1;
const int IN1 = 2;
const int IN2 = 3;

const int EXT_EN  = 4;   // Enable / PWM
const int EXT_IN1 = 43;  // Direction 1
const int EXT_IN2 = 44;  // Direction 2

// PWM settings
const int PWM_CH   = 0;
const int PWM_FREQ = 20000;
const int PWM_RES  = 8;   // 0-255

static const int WALL_LEFT_PIN   = 10; // yellow
static const int WALL_RIGHT_PIN  = 11; // green
static const int FLAP_SERVO_PIN  = 12; // flap

const int POWER_PIN = 15;

// Speed
const int EXT_SPEED = 150;

// Softer angles
const int FLAP_DOWN  = 10;
const int FLAP_UP    = 70;

const int WALL_LEFT_45  = 40;
const int WALL_RIGHT_45 = 140;

const int WALL_LEFT_90  = 70;
const int WALL_RIGHT_90 = 110;

// Track servo positions
int currentWallLeft  = WALL_LEFT_45;
int currentWallRight = WALL_RIGHT_45;
int currentFlap      = FLAP_DOWN;

// ===================== MOTOR / ACTUATOR =====================

void stopExtender() {
  digitalWrite(EXT_IN1, LOW);
  digitalWrite(EXT_IN2, LOW);
  ledcWrite(PWM_CH, 0);
  Serial.println("Extender stopped");
}

void extenderForward(int speedVal) {
  digitalWrite(EXT_IN1, HIGH);
  digitalWrite(EXT_IN2, LOW);
  ledcWrite(PWM_CH, speedVal);
  Serial.println("Extender forward");
}

void extenderBackward(int speedVal) {
  digitalWrite(EXT_IN1, LOW);
  digitalWrite(EXT_IN2, HIGH);
  ledcWrite(PWM_CH, speedVal);
  Serial.println("Extender backward");
}

void stopActuator() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  Serial.println("Actuator stopped");
}

void extendActuator() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  Serial.println("Actuator extending");
}

void retractActuator() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  Serial.println("Actuator retracting");
}

// ===================== SERVO HELPERS =====================

void attachWalls() {
  if (!wallLeftServo.attached()) {
    wallLeftServo.attach(WALL_LEFT_PIN, 500, 2400);
    delay(50);
  }
  if (!wallRightServo.attached()) {
    wallRightServo.attach(WALL_RIGHT_PIN, 500, 2400);
    delay(50);
  }
}

void detachWalls() {
  if (wallLeftServo.attached()) {
    wallLeftServo.detach();
    delay(20);
  }
  if (wallRightServo.attached()) {
    wallRightServo.detach();
    delay(20);
  }
}

void attachFlap() {
  if (!FlapServo.attached()) {
    FlapServo.attach(FLAP_SERVO_PIN, 500, 2400);
    delay(50);
  }
}

void detachFlap() {
  if (FlapServo.attached()) {
    FlapServo.detach();
    delay(20);
  }
}

void moveWallsSequential(int targetLeft, int targetRight, int stepDelay = 30) {
  attachWalls();

  int startLeft = currentWallLeft;
  int leftSteps = abs(targetLeft - startLeft);
  if (leftSteps > 0) {
    for (int i = 1; i <= leftSteps; i++) {
      int newLeft = startLeft + (targetLeft - startLeft) * i / leftSteps;
      wallLeftServo.write(newLeft);
      delay(stepDelay);
    }
  }
  currentWallLeft = targetLeft;

  delay(200);

  int startRight = currentWallRight;
  int rightSteps = abs(targetRight - startRight);
  if (rightSteps > 0) {
    for (int i = 1; i <= rightSteps; i++) {
      int newRight = startRight + (targetRight - startRight) * i / rightSteps;
      wallRightServo.write(newRight);
      delay(stepDelay);
    }
  }
  currentWallRight = targetRight;

  Serial.print("Walls sequential to L=");
  Serial.print(currentWallLeft);
  Serial.print(" R=");
  Serial.println(currentWallRight);
}

void moveFlapSlow(int targetFlap, int stepDelay = 35) {
  attachFlap();

  int startFlap = currentFlap;
  int steps = abs(targetFlap - startFlap);
  if (steps == 0) return;

  for (int i = 1; i <= steps; i++) {
    int newFlap = startFlap + (targetFlap - startFlap) * i / steps;
    FlapServo.write(newFlap);
    delay(stepDelay);
  }

  currentFlap = targetFlap;

  Serial.print("Flap at ");
  Serial.println(currentFlap);
}

// ===================== SETUP =====================

void setup() {
  pinMode(POWER_PIN, OUTPUT);
  digitalWrite(POWER_PIN, HIGH);

  Serial.begin(115200);

  wallLeftServo.setPeriodHertz(50);
  wallRightServo.setPeriodHertz(50);
  FlapServo.setPeriodHertz(50);

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  digitalWrite(ENA, HIGH);

  pinMode(EXT_IN1, OUTPUT);
  pinMode(EXT_IN2, OUTPUT);

  ledcSetup(PWM_CH, PWM_FREQ, PWM_RES);
  ledcAttachPin(EXT_EN, PWM_CH);

  stopExtender();
  stopActuator();

  // Stage 1: retract LA to level with wall
  delay(1000);

  retractActuator();
  delay(1000);

  stopActuator();
  delay(1000);

  // Stage 2: Extend Extender Rack
  extenderBackward(EXT_SPEED);
  delay(1200);

  stopExtender();
  delay(4000);

  // Stage 3: Retract Extender Rack
  extenderForward(EXT_SPEED);
  delay(800);

  stopExtender();
  delay(4000);

  // Stage 4: upsies
  extendActuator();
  delay(2000);

  stopActuator();
  delay(4000);

  // Stage 5: Scoop 90 deg ONLY
  moveWallsSequential(WALL_LEFT_90, WALL_RIGHT_90, 30);
  delay(400);

  

  // Stage 7: Retract LA
  retractActuator();
  delay(4400);

  stopActuator();
  delay(2000);

  // Stage 8: Extend Forward Max
  extenderBackward(EXT_SPEED);
  delay(1400);

  stopExtender();
  delay(4000);

  // Stage 9: flap only flips here
  moveFlapSlow(FLAP_UP, 45);
  delay(400);
  detachFlap();
  delay(300);

  // Stage 10
  extendActuator();
  delay(4000);

  stopActuator();
  delay(4000);

  // Stage 11: back to 45 deg
  moveWallsSequential(WALL_LEFT_45, WALL_RIGHT_45, 30);
  delay(400);
  detachWalls();
  delay(300);

  // Stage 12: Extend full way
  extendActuator();
  delay(10000);

  stopActuator();
  delay(2000);

  // Stage 13: Retract to start state
  retractActuator();
  delay(8500);

  stopActuator();
  delay(2000);

  detachWalls();
  detachFlap();


  extenderForward(EXT_SPEED);
  delay(1400);

  stopExtender();
  delay(4000);
}

void loop() {
}