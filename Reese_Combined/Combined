  #include <Arduino.h>
  #include <ESP32Servo.h>

  Servo wallLeftServo;
  Servo wallRightServo; // FROM THE REAR
  Servo FlapServo;

  // L298N pins
  const int ENA = 1;  // choose the ESP32 pin connected to ENA
  const int IN1 = 2;
  const int IN2 = 3;

  const int EXT_EN  = 4;   // Enable / PWM
  const int EXT_IN1 = 43;  // Direction 1
  const int EXT_IN2 = 44;  // Direction 2

  // PWM settings
  const int PWM_CH   = 0;
  const int PWM_FREQ = 20000;
  const int PWM_RES  = 8;   // 0-255

  static const int WALL_LEFT_PIN   = 10; // yellow
  static const int WALL_RIGHT_PIN  = 11; // green
  static const int FLAP_SERVO_PIN  = 12; // flap

  // Speed (0 = off, 255 = full speed)
  const int EXT_SPEED = 150;

  void stopExtender() {
    digitalWrite(EXT_IN1, LOW);
    digitalWrite(EXT_IN2, LOW);
    ledcWrite(PWM_CH, 0);
    Serial.println("Extender stopped");
  }
  
  void extenderForward(int speedVal) {
    digitalWrite(EXT_IN1, HIGH);
    digitalWrite(EXT_IN2, LOW);
    ledcWrite(PWM_CH, speedVal);
    Serial.println("Extender forward");
  }
  
  void extenderBackward(int speedVal) {
    digitalWrite(EXT_IN1, LOW);
    digitalWrite(EXT_IN2, HIGH);
    ledcWrite(PWM_CH, speedVal);
    Serial.println("Extender backward");
  }

  void stopActuator() {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
  }

  void extendActuator() {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
  }

  void retractActuator() {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
  }

  void setup() {
    pinMode(15, OUTPUT);
    digitalWrite(15, HIGH);

    Serial.begin(115200); 

    wallLeftServo.setPeriodHertz(50);
    wallRightServo.setPeriodHertz(50);
    FlapServo.setPeriodHertz(50);

    wallLeftServo.attach(WALL_LEFT_PIN, 500, 2400);
    wallRightServo.attach(WALL_RIGHT_PIN, 500, 2400);
    // FlapServo.attach(FLAP_SERVO_PIN, 500, 2400);

    pinMode(ENA, OUTPUT);
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    digitalWrite(ENA, HIGH);   // enable the channel

    pinMode(EXT_IN1, OUTPUT);
    pinMode(EXT_IN2, OUTPUT);
  
    ledcSetup(PWM_CH, PWM_FREQ, PWM_RES);
    ledcAttachPin(EXT_EN, PWM_CH);
  
    stopExtender();

    // Start Sequence
    
    // stage 0, flip scoop flap

    // FlapServo.attach(FLAP_SERVO_PIN, 500, 2400);  // attach seperately 

  // FlapServo.write(0);      // facing down, starting state
    // delay(3000);


    // Stage 1 retract LA to level with wall

    retractActuator();
    delay(600);


    stopActuator();
    delay(2000);   // neutral wait, actuator not moving

    // Stage 2 Extend Extender Rack   (backward is forward rn)  pushing rocks
    extenderBackward(EXT_SPEED);
    delay(1200);


    stopExtender();
    delay(4000);   // wait

    // Stage 3 Retract Extender Rack   (move back)
    extenderForward(EXT_SPEED);
    delay(800);
    
    stopExtender();
    delay(4000);  // wait 

    

    // stage 4   upsies
    extendActuator();
    delay(2000);
    
    stopActuator();
    delay(4000);

    // Stage 5 Scoop 90 deg


    wallLeftServo.write(180);      // facing down, starting state
    wallRightServo.write(0);


    delay(4000);







    

    // Stage .. Extend Full way 
    extendActuator();
    delay(15000);

    


    // Stage .. Retract to start state 
    retractActuator();
    delay(9000);

    stopActuator();
    delay(4000);
    

    
  }

  void loop() {
  }